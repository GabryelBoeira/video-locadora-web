#DB-Video-Locadora acessos
VIDEOLOCADORA_DATASOURCE_URL=jdbc:mysql://db:3306
VIDEOLOCADORA_DB_USERNAME=root
VIDEOLOCADORA_DB_PASSWORD=root
VIDEOLOCADORA_DB_DATABASE=videolocadora
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080


#Kafka
KAFKA_SERVER=kafka:9092
SPRING_KAFKA_TOPICS_DOMAIN_EVENTS=videolocadora.domain-events

#KEYCLOAK
KEYCLOAK_URI=http://keycloak:8080/realms/video-locadora
KEYCLOAK_CERTS_URI=http://keycloak:8080/realms/video-locadora/protocol/openid-connect/certs
