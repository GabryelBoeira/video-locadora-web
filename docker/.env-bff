# Keycloak OAuth2 Client (BFF)
KEYCLOAK_BFF_CLIENT_ID=bff-client
KEYCLOAK_BFF_CLIENT_SECRET=bff-client-secret-change-me

# Endpoint do Keycloak acessado pelo BROWSER do usuario (host externo)
KEYCLOAK_AUTHORIZATION_URI=http://localhost:8081/realms/video-locadora/protocol/openid-connect/auth

# Endpoints do Keycloak acessados pelo proprio processo do BFF (host interno Docker)
KEYCLOAK_TOKEN_URI=http://keycloak:8080/realms/video-locadora/protocol/openid-connect/token
KEYCLOAK_CERTS_URI=http://keycloak:8080/realms/video-locadora/protocol/openid-connect/certs
KEYCLOAK_USERINFO_URI=http://keycloak:8080/realms/video-locadora/protocol/openid-connect/userinfo

# Backend video-locadora (chamado pelo processo do BFF -> host interno)
VIDEOLOCADORA_BASE_URL=http://video-locadora:8080/videolocadora

# Logout
APP_POST_LOGOUT_REDIRECT_URI=http://localhost:8083/

# CORS (origem de um futuro frontend que consumir o BFF de outra porta)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
